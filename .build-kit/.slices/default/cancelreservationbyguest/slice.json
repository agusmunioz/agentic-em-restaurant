  "specifications": [
    {
      "title": "Successfully cancel a reservation",
      "given": [
        {
          "title": "Reservation Placed",
          "fields": {
            "reservation_id": "1232-ASD-123"
          }
        }
      ],
      "when": {
        "title": "Cancel Reservation",
        "fields": {
          "reservation_id": "1232-ASD-123"
